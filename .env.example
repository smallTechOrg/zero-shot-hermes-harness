# Data Analyst Agent — environment.
# Copy to .env and set at least one provider key for Phase 1.
# .env is gitignored and is the ONLY manual setup step. Never commit real keys.

# --- LLM provider: auto | anthropic | gemini | openrouter (auto = detect from keys) ---
AGENT_LLM_PROVIDER=auto
# Leave blank to use the provider's sensible default model, or pin one.
AGENT_LLM_MODEL=

# Set exactly ONE of these (or more; resolver picks whichever key is present):
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=
AGENT_OPENROUTER_API_KEY=

# --- Persistence (SQLite for run history, sessions, query cache) ---
AGENT_DATABASE_URL=sqlite:///./data/app.db

# --- Phase 2 (MsSQL) — leave unset until Phase 2 is enabled ---
# AGENT_MSSQL_CONNECTION_STRING=Server=.;Database=UP_Police;Trusted_Connection=yes;

# --- Server ---
PORT=8001
AGENT_LOG_LEVEL=INFO
